# ==== Rahasia untuk dev LOKAL (dibaca wrangler sebagai `env.*`) ====
# File ini git-ignored. JANGAN pernah di-commit.
# Untuk produksi pakai: wrangler secret put DIRECT_URL

# ---------------------------------------------------------------------------
# DIRECT_URL — string koneksi Postgres, LANGSUNG tanpa Hyperdrive.
#
# PENTING: `wrangler dev` mode LOKAL (Miniflare) tidak bisa menyambung ke
# database di internet. Worker-mu akan jalan dan /api/health membalas, tapi
# rute yang menyentuh DB akan gagal. Untuk uji DB dari mesin sendiri pakai:
#
#     wrangler dev --remote
#
# Format: postgresql://postgres:PASSWORD@db.<project-ref>.supabase.co:5432/postgres
#
# CATATAN KEAMANAN: jalur langsung ini TIDAK terenkripsi (lihat penjelasan
# panjang di src/index.ts). Jangan dipakai untuk data sensitif tanpa
# membatasi hak akses role-nya.
# ---------------------------------------------------------------------------
DIRECT_URL="GANTI_DENGAN_CONNECTION_STRING"

# Token untuk rute tulis (POST /api/games).
# Bikin acak yang panjang, contoh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WRITE_TOKEN="GANTI_DENGAN_TOKEN_ACAK_PANJANG"

# Claim fallback: nilai rahasia hanya di .dev.vars/secret Worker.
RYUU_AUTH_CODE="GANTI_DENGAN_KEY_PROVIDER_2"
HUBCAP_API_KEYS='[{"id":"key_01","key":"GANTI_DENGAN_KEY_PROVIDER_3"}]'
ASSET_MASTER_KEY_HEX="GANTI_DENGAN_MASTER_KEY_HEX_64_KARAKTER"
# Konfigurasi R2 untuk GET/PUT file Lua:
R2_ENDPOINT="https://ACCOUNT.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="GANTI_DENGAN_ACCESS_KEY"
R2_SECRET_ACCESS_KEY="GANTI_DENGAN_SECRET_KEY"
R2_BUCKET="GANTI_DENGAN_NAMA_BUCKET"
